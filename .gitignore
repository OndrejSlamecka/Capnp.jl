# Ignore everything by default
*

# Do not ignore directories, so we can traverse them
!*/

# Allow top-level files
!capnpc-jl
!CHANGELOG.md
!codecov.yml
!CODE_OF_CONDUCT.md
!CONTRIBUTING.md
!CONTRIBUTORS.md
!.gitignore
!.JuliaFormatter.toml
!KNOWN_ISSUES.md
!LICENSE.md
!Project.toml
!README.md
!ROADMAP.md
!SECURITY.md

# Allow specific directories
!docs/**
!example/**
!.github/**
!src/**
!ext/**
!test/**

# --- Specific Exclusions within Allowed Directories ---

# AI generated files
.ai
.claude
CLAUDE.md
AGENTS.md
.specify
specs/

# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# File generated by Pkg
Manifest*.toml

# File generated by the Preferences package
LocalPreferences.toml
JuliaLocalPreferences.toml

.vscode
*.capnp.jl
!src/schema.capnp.jl

# Docs
docs/build/
docs/site/

# C++ interop test artifacts
test/interop/cpp_client_test
test/interop/dump_bootstrap_return
test/interop/dump_call_return
test/interop/home/
test/interop/test_persistent_cpp
